{"nodes": [{"id": "readme", "label": "README — Mes Listes", "file_type": "document", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_version_management", "label": "Version Number Management Policy", "file_type": "rationale", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "## Numéro de version", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Version number must be updated synchronously in 4 places (app.js VERSION, sw.js CACHE name, sw.js ASSETS ?v params, index.html script/style ?v params). Without coordinated cache-busting, a freshly downloaded page can run with stale cached scripts whose identifiers no longer match, causing silent failure on the first unknown reference."}, {"id": "readme_firebase_integration", "label": "Firebase Authentication and Firestore Sync", "file_type": "concept", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "## Compte et synchronisation", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_notification_system", "label": "Push Notification System via Cloudflare Worker and FCM", "file_type": "concept", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "## Notifications", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A static site cannot send push notifications itself, so a Cloudflare Worker intermediary is used. The app never sends device tokens to the Worker; it only sends a list ID and identity token. The Worker verifies membership and fetches tokens itself, preventing any account from spamming arbitrary devices."}, {"id": "readme_list_sharing", "label": "Collaborative List Sharing Feature", "file_type": "concept", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "### Partager une liste", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invitations are stored in Firestore keyed to the email address rather than sending actual emails, because the app has no server to send mail. Invitations by email also prevent address enumeration: the mapping from email to UID is only resolved when the recipient authenticates."}, {"id": "readme_friend_code", "label": "Friend Code Invitation System", "file_type": "concept", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "On peut aussi inviter par code ami", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Friend codes allow sharing list invitations without revealing the inviter's email address. Codes are stored in the `codes` collection, readable one-by-one if the exact code is known but never listable, preventing directory enumeration."}, {"id": "readme_admin_system", "label": "Administrator Accounts, Badges, and Announcements", "file_type": "concept", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "## Administration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin UID must be declared in both sync.js (Sync.MARQUES table) and firestore.rules (estAdmin function) and kept in sync. Using UID (not email) is the only identifier that Firestore rules can verify without spoofing. An admin is never blocked by their own announcement."}, {"id": "readme_pwa_offline", "label": "PWA Offline-First Capability", "file_type": "concept", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "## Installer sur l'iPhone", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_backup_restore", "label": "Local Backup and Restore (iCloud / Files)", "file_type": "concept", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "## Sauvegarder tes données", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_pseudo_system", "label": "Display Name (Pseudo) System", "file_type": "concept", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "## Pseudo", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserved pseudos are stored in the `pseudos` collection, readable one-by-one but never listable. A pseudo is normalized to lowercase with slashes replaced by spaces to prevent Firestore path injection. Admin pseudos are auto-reserved on save."}, {"id": "app_js", "label": "app.js — App Logic, Data, Rendering, Drag-and-Drop", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "Structure table — app.js", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sync_js", "label": "sync.js — Firebase Account and List Synchronization", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "Structure table — sync.js", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sw_js", "label": "sw.js — Service Worker (Offline Cache)", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "Structure table — sw.js", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firebase_config_js", "label": "firebase-config.js — Firebase Project Credentials", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "Structure table — firebase-config.js", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "firestore_rules", "label": "firestore.rules — Firestore Security Rules", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "Structure table — firestore.rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "worker_notifier_js", "label": "worker/notifier.js — Cloudflare Worker Push Notifier", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "Structure table — worker/notifier.js", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "styles_css", "label": "styles.css — Appearance, Light/Dark Themes", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "Structure table — styles.css", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manifest_json", "label": "manifest.json — Web App Manifest (PWA Install Config)", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\README.md", "source_location": "Structure table — manifest.json", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_html", "label": "tests.html — Test Harness", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\tests.html", "source_location": "line 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_iframe_harness", "label": "Iframe-Based Real-App Eval Test Harness", "file_type": "concept", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\tests.html", "source_location": "Tests de « Mes Listes » comment block, line 138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app is loaded in an invisible iframe and driven via eval() executed in its window context. This is necessary because app variables are declared with const/let and do not become window properties — they would be invisible to an external frame. The app is loaded with ?tests=1 to skip service worker registration, preventing a mid-test reload after an update."}, {"id": "tests_migration_suite", "label": "Data Migration Test Suite", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\tests.html", "source_location": "suite('Migration des anciennes données')", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_sync_suite", "label": "Firestore Write and Settings Convergence Test Suites", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\tests.html", "source_location": "suite('Écritures vers Firestore'), suite('Convergence des réglages')", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_invitation_suite", "label": "Invitation System Test Suite", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\tests.html", "source_location": "suite('Invitations')", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_worker_suite", "label": "Cloudflare Worker Notification Test Suite", "file_type": "code", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\tests.html", "source_location": "suite('Avis envoyés aux autres appareils')", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "icons_icon_180_app_icon", "label": "App Icon (180px)", "file_type": "image", "source_file": "C:\\Users\\Anthony Hugon\\OneDrive\\Apps\\Mes Listes\\icons\\icon-180.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "icons_icon_180_desig