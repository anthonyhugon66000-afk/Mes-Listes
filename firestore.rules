rules_version = '2';

/* Règles d'accès à Firestore — à coller dans la console Firebase :
   Firestore Database -> onglet Règles -> Publier.

   Sans elles, la base refuse tout (mode production) et l'app affichera
   « Accès refusé par les règles de la base ». */

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }

    /* Comptes administrateurs, désignés par leur UID. CETTE LISTE DOIT RESTER
       D'ACCORD avec `Sync.MARQUES` dans `sync.js` (les entrées de type `admin`) :
       un admin ajouté d'un côté sans l'autre verra ses écritures refusées, ou
       gardera des pouvoirs qu'on croyait retirés. L'UID est le seul identifiant
       infalsifiable — un e-mail dans le jeton peut être non vérifié. */
    function estAdmin() {
      return connecte()
        && request.auth.uid in [
          'jXcKGdfqQxNM8SZN3E4Y1nKX5d53'   // compte Gmail
        ];
    }

    /* Annonces globales : chaque document est une annonce indépendante.
       Tout compte connecté peut lire ; seul un admin crée, modifie ou supprime. */
    match /annonces/{id} {
      allow read: if connecte();
      allow write: if estAdmin();
    }

    /* Pseudos réservés : pseudo -> compte. Consultable un par un (`get`) pour
       vérifier une disponibilité, jamais listable. Seuls les admins réservent ou
       libèrent — leur propre pseudo, ou celui d'un autre compte. */
    match /pseudos/{nom} {
      allow get: if connecte();
      allow write: if estAdmin();
    }

    /* Réglages personnels : thème, couleur, pseudo, code ami, jetons de
       notification. Chacun chez soi. */
    match /users/{userId} {
      allow read, write: if connecte() && request.auth.uid == userId;
    }

    /* Annuaire des codes ami : code -> compte. Consultable un par un si l'on
       connaît le code exact (`get`), jamais listable — personne ne peut
       parcourir l'annuaire. Un code, une fois pris, est définitif. */
    match /codes/{code} {
      allow get: if connecte();
      allow create: if connecte() && request.resource.data.uid == request.auth.uid;
    }

    /* Invitations en attente. Adressées soit à une adresse e-mail (la personne
       n'a peut-être pas de compte), soit à un identifiant de compte (invitée par
       son code ami). Les deux champs existent toujours, l'un vide : l'accès
       direct — et non `get` — est nécessaire pour que Firestore autorise les
       requêtes filtrées dessus. */
    match /invites/{inviteId} {

      allow create: if connecte()
        && request.resource.data.invitePar == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/lists/$(request.resource.data.listId)).data.members;

      allow read, delete: if connecte()
        && (resource.data.cibleEmail == request.auth.token.email
            || resource.data.cibleUid == request.auth.uid
            || resource.data.invitePar == request.auth.uid);
    }

    /* Retours utilisateurs (commentaires et bugs).
       - Tout connecté peut créer.
       - Chacun peut lire ses propres retours (pour voir les réponses admin).
       - Seuls les admins peuvent lire tout, répondre (update limité aux champs
         de réponse) et supprimer. */
    match /feedback/{id} {
      allow create: if connecte()
        && request.resource.data.type in ['commentaire', 'bug']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read: if estAdmin()
        || (connecte() && resource.data.uid == request.auth.uid);
      allow update: if estAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reponse', 'repondeuNom', 'repondeuUid', 'reponseLe']);
      allow delete: if estAdmin();
    }

    /* Avatars : visible par tout compte connecté (pour afficher la photo d'un
       membre dans une liste partagée) ; seul le propriétaire peut modifier. */
    match /avatars/{userId} {
      allow read: if connecte();
      allow write: if connecte() && request.auth.uid == userId;
    }

    /* Liste d'amis : chacun chez soi. Contient `liste: [{ uid, code }]`. */
    match /amis/{userId} {
      allow read, write: if connecte() && request.auth.uid == userId;
    }

    /* Demandes d'amitié.
       demandeId = ${deUid}__${versUid} — direction explicite.
       L'expéditeur crée ; les deux peuvent lire et supprimer ;
       le destinataire peut marquer accepte + codeVers pour finaliser. */
    match /demandes/{demandeId} {
      allow create: if connecte()
        && request.resource.data.de == request.auth.uid
        && request.resource.data.vers is string
        && request.resource.data.vers != request.auth.uid;
      allow read: if connecte()
        && (resource.data.de == request.auth.uid || resource.data.vers == request.auth.uid);
      allow update: if connecte()
        && resource.data.vers == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['accepte', 'codeVers']);
      allow delete: if connecte()
        && (resource.data.de == request.auth.uid || resource.data.vers == request.auth.uid);
    }

    /* Messagerie entre amis.
       convId = [uid1, uid2].sort().join('__')
       Seuls les participants peuvent lire et écrire. */
    match /conversations/{convId} {
      allow create: if connecte()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      // resource == null quand le document n'existe pas encore (getDoc avant création)
      allow read: if connecte()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow update: if connecte()
        && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        // convId = [uid1, uid2].sort().join('__') — on vérifie l'UID sans get() cross-doc.
        function participantConv() {
          return convId.matches(request.auth.uid + '__.*')
              || convId.matches('.*__' + request.auth.uid);
        }
        allow read: if connecte() && participantConv();
        allow create: if connecte()
          && participantConv()
          && request.resource.data.de == request.auth.uid
          && request.resource.data.texte is string
          && request.resource.data.texte.size() > 0
          && request.resource.data.texte.size() <= 1000;
      }
    }

    match /lists/{listId} {

      function membresApres() { return request.resource.data.get('members', []); }

      // Accès direct pour la lecture : autoriser la requête `array-contains`
      // suppose que Firestore reconnaisse le champ, ce qu'un `get` lui masque.
      function membre() {
        return connecte() && request.auth.uid in resource.data.members;
      }

      function proprietaire() {
        return connecte() && request.auth.uid == resource.data.get('owner', '');
      }

      // Le contenu change, l'appartenance non : cocher, renommer, réordonner.
      // `get` avec valeur par défaut, car les listes d'avant le partage n'ont
      // pas de `memberEmails` et lire un champ absent ferait échouer la règle.
      function contenuSeul() {
        return request.resource.data.get('owner', '') == resource.data.get('owner', '')
          && membresApres() == resource.data.members
          && request.resource.data.get('memberEmails', []) == resource.data.get('memberEmails', []);
      }

      // Un invité s'ajoute lui-même, et rien d'autre. On vérifie qu'une
      // invitation existe à son nom — par adresse ou par identifiant.
      function accepteInvitation() {
        return connecte()
          && (exists(/databases/$(database)/documents/invites/$(listId + '__' + request.auth.token.email))
              || exists(/databases/$(database)/documents/invites/$(listId + '__u_' + request.auth.uid)))
          && request.resource.data.get('owner', '') == resource.data.get('owner', '')
          && membresApres() == resource.data.members.concat([request.auth.uid]);
      }

      // Quitter une liste : on se retire, sans toucher aux autres.
      function seRetire() {
        return membre()
          && request.resource.data.get('owner', '') == resource.data.get('owner', '')
          && !(request.auth.uid in membresApres())
          && resource.data.members.hasAll(membresApres());
      }

      allow create: if connecte()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members.hasOnly([request.auth.uid]);

      allow read: if membre();

      // Supprimer pour tout le monde reste au propriétaire ; les autres quittent.
      allow delete: if proprietaire();

      allow update: if (membre() && contenuSeul())
        || (proprietaire() && request.resource.data.get('owner', '') == resource.data.get('owner', ''))
        || accepteInvitation()
        || seRetire();
    }
  }
}
